# API keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM provider: "gemini" or "groq"
LLM_PROVIDER=groq

# Optional LangChain backend settings.
# Main app still uses the custom RAG pipeline unless you run src/langchain_rag.py.
LANGCHAIN_LLM_PROVIDER=groq
LANGCHAIN_MODEL=llama-3.1-8b-instant

# Research/experiment settings
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemma-3-1b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Dual-model configuration (to avoid rate limits)
CHATBOT_MODEL=llama-3.1-8b-instant  # Cheaper/faster for interactive chatbot
BENCHMARK_MODEL=llama-3.3-70b-versatile  # Higher quality for benchmarks/evaluation

EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
VECTOR_BACKEND=qdrant
QDRANT_PATH=data\qdrant_local
QDRANT_COLLECTION=cusb_chunks
MARKDOWN_FILE=CUSB_markdown.md
TOP_K=5
MAX_CONTEXT=3000
RETRIEVAL_CANDIDATES=25
INCLUDE_QA_IN_INDEX=true
USE_RERANKER=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# IEEE/PhD research experiment settings
RESEARCH_RANDOM_SEED=42
RESEARCH_TRAIN_RATIO=0.70
RESEARCH_VALIDATION_RATIO=0.15
RESEARCH_TEST_RATIO=0.15
DENSE_TOP_K=40
BM25_TOP_K=40
FINAL_TOP_K=5
RRF_K=60
FACTUAL_OVERLAP_THRESHOLD=0.50

# RTX 4070 Super local research defaults
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Local admin API
JWT_SECRET_KEY=change-this-local-secret
ADMIN_PASSWORD=admin123
