# Copy these values into the project-root .env file on the VPS.
DOMAIN=chatbot.example.com

# Required secrets
GEMINI_API_KEY=replace-with-a-new-rotated-key
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Current project defaults
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DOCKER_VECTOR_BACKEND=faiss
QDRANT_COLLECTION=cusb_chunks
USE_RERANKER=false
